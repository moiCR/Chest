generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  SELLER
  ADMIN
}

enum ProductType {
  PLUGIN
  MOD
}

enum ProductStatus {
  ACTIVE
  DRAFT
  DISABLED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SUSPENDED
}

enum LicenseLogType {
  VALIDATION_SUCCESS
  VALIDATION_FAILED
  IP_ADDED
  IP_REMOVED
  IP_LIMIT_CHANGED
  HWID_CHANGED
  LICENSE_CREATED
  LICENSE_REVOKED
  LICENSE_EXPIRED
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  username String @unique
  email    String @unique
  password String

  role   UserRole @default(USER)
  active Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] @relation("SellerProducts")
  licenses License[] @relation("UserLicenses")
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  name        String
  slug        String  @unique
  description String?

  status ProductStatus @default(DRAFT)
  type   ProductType

  version  String
  fileName String
  r2Key    String  @unique
  fileSize Int?
  sha256   String?

  downloadCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerId String @db.Uuid
  seller   User   @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)

  licenses License[]
}

model License {
  id  String @id @default(uuid()) @db.Uuid
  key String @unique

  status LicenseStatus @default(ACTIVE)

  permanent Boolean   @default(false)
  expireAt  DateTime?

  maxIps   Int @default(1)
  maxHwids Int @default(1)

  autoAdjustIps Boolean @default(true)

  lastCheck DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String @db.Uuid
  userId    String @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation("UserLicenses", fields: [userId], references: [id], onDelete: Cascade)

  ips   LicenseIp[]
  hwids LicenseHwid[]
  logs  LicenseLog[]
}

model LicenseIp {
  id String @id @default(uuid()) @db.Uuid

  licenseId String  @db.Uuid
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  ip        String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([licenseId, ip])
}

model LicenseHwid {
  id String @id @default(uuid()) @db.Uuid

  licenseId String  @db.Uuid
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  hwid      String
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([licenseId, hwid])
}

model LicenseLog {
  id String @id @default(uuid()) @db.Uuid

  licenseId String  @db.Uuid
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  type LicenseLogType

  ip      String?
  hwid    String?
  success Boolean?
  reason  String?

  oldValue String?
  newValue String?

  createdAt DateTime @default(now())
}
